{
  "name": "hanpyeongsaengtok-desktop",
  "version": "0.1.0",
  "productName": "한평생톡",
  "private": true,
  "description": "한평생톡 — 단체 카카오톡 발송 데스크톱 앱 (Next 대시보드 + PC 프로그램)",
  "main": "main.js",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "build:daemon": "node scripts/build-daemon.mjs",
    "build:daemon-mac": "node scripts/build-daemon-mac.mjs",
    "start": "electron .",
    "dist:win": "npm run build:web && npm run build:daemon && electron-builder --win",
    "dist:mac": "npm run build:web && npm run build:daemon-mac && electron-builder --mac",
    "pack:mac": "npm run build:web && npm run build:daemon-mac && electron-builder --mac --dir"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.hanpyeongsaengtok.desktop",
    "icon": "icons/icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      "icons/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "icons/icon.png"
    },
    "afterPack": "scripts/after-pack.cjs",
    "dmg": {
      "title": "${productName} ${version}"
    },
    "artifactName": "HanpyeongsaengTok-${version}-${os}-${arch}.${ext}"
  }
}
