# 카카오 디벨로퍼스(https://developers.kakao.com) > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=
# 카카오 로그인 > 보안 > Client Secret (사용 설정한 경우에만)
KAKAO_CLIENT_SECRET=
# 카카오 로그인 > Redirect URI 에 똑같이 등록해야 합니다
KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback

# 세션 쿠키 서명용 비밀값 (32자 이상 아무 문자열)
SESSION_SECRET=change-me-to-a-long-random-string-please

# 개발용 테스트 로그인 버튼 (production 빌드에서는 항상 꺼짐)
DEV_LOGIN=1

# 나중에 만들 PC 데몬 주소 (설치된 나인톡과 겹치지 않게 46301 대신 47301)
NEXT_PUBLIC_DAEMON_URL=http://localhost:47301
